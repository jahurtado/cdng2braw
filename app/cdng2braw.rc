// Recursos de Windows de la app: icono del ejecutable y datos de versión que muestra el Explorador.
// En macOS esto lo lleva el Info.plist del bundle (MACOSX_BUNDLE_* en app/CMakeLists.txt).
// Solo se compila con MSVC; lo añade app/CMakeLists.txt a las fuentes de cdng_app.

#include <windows.h>

// El 1 es lo que busca Windows para el icono del ejecutable y el del Explorador.
1 ICON "icon/AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 1, 0
PRODUCTVERSION 1, 0, 1, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = inglés (EE. UU.), 04b0 = Unicode. La app es bilingüe, pero estos campos los lee el sistema.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "El Cacharrista"
            VALUE "FileDescription", "CDNG to BRAW Converter"
            VALUE "FileVersion", "1.0.1"
            VALUE "InternalName", "cdng2braw"
            VALUE "LegalCopyright", "Jose A. Hurtado"
            VALUE "OriginalFilename", "cdng2braw.exe"
            VALUE "ProductName", "CDNG to BRAW Converter"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
